# mock | live — mock lets a clean clone run with zero credentials
HRIS_MODE=

# from the Google Sheet's URL (…/spreadsheets/d/<this>/edit)
GOOGLE_SHEET_ID=

# base64 of the Google service-account JSON key (never commit the raw file)
GOOGLE_SERVICE_ACCOUNT_JSON_B64=

# days-before-expiry threshold for the iqama expiry alert job
IQAMA_ALERT_THRESHOLD_DAYS=
